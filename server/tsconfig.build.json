{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../",
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": [
    "./**/*",
    "../shared/**/*"
  ],
  "exclude": [
    "../client",
    "../vite.config.ts",
    "../node_modules",
    "./dist",
    "**/*.test.ts"
  ]
}