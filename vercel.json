{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "dist/public/**", 
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public" 
      }
    },
    {
      "src": "dist/server/index.js", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/server/**"] 
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/server/index.js" 
    },
    {
      "src": "/(.*)",
      "dest": "/dist/public/index.html" 
    }
  ],
  "outputDirectory": "dist" 
}